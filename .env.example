# --- Common ---
NODE_ENV=development
TZ=Asia/Shanghai

# --- API (NestJS) ---
API_PORT=3000
API_HOST=0.0.0.0

# User images: multipart upload storage (default: apps/api/uploads/user-images when cwd is api)
# UPLOAD_DIR=

# Public origin for stored image URLs (behind reverse proxy / Docker, set to browser-reachable URL)
# API_PUBLIC_BASE_URL=https://your-api.example.com

# --- Web / Admin (Vite, optional) ---
VITE_API_BASE_URL=http://localhost:3000
WEB_PORT=5173

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/peima?schema=public

# docker-compose (containers connect to service name `postgres`)
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=peima
DOCKER_DATABASE_URL=postgresql://user:password@postgres:5432/peima?schema=public

# --- Redis / queues (worker) ---
REDIS_URL=redis://localhost:6379

# Worker cron (P0: daily 20:00)
MATCH_CRON=0 20 * * *

# --- AI providers (placeholders) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- P6: Copilot LLM (OpenAI-compatible POST /v1/chat/completions). Full runbook: docs/P6/P6.2-copilot-llm-runbook.md (§9+ = logs & stability). ---
# AI_COPILOT_ENABLED=0
#
# AI_PROVIDER — 厂商/品牌 slug，用于成功响应 sourceType=model_<slug>。强烈建议显式设置，避免仅靠 host 推断。
#   未设置时：按 AI_BASE_URL 的 hostname 推断（含 deepseek / openai / anthropic / azure 等）；无法识别 → slug 为 openai_compatible（仅表示「OpenAI 兼容协议」，不表示官方 OpenAI）。
# AI_PROVIDER=deepseek
#
# AI_BASE_URL — 兼容 OpenAI Chat Completions 的根 URL，无尾部斜杠。DeepSeek: https://api.deepseek.com ；官方 OpenAI 可留空（默认 https://api.openai.com）。
# AI_BASE_URL=https://api.deepseek.com
#
# AI_MODEL — 供应商侧的 deployment / 模型名。DeepSeek 常用 deepseek-chat；OpenAI 示例 gpt-4o-mini。
# AI_MODEL=deepseek-chat
#
# AI_API_KEY — 勿提交仓库；缺失时接口仍 200 但回退 rule_based（见 runbook §10）。
# AI_API_KEY=
#
# AI_TIMEOUT_MS — 单次 Chat Completions 毫秒超时；超时 → fallback（无自动重试，见 runbook §11）。
# AI_TIMEOUT_MS=25000

# --- P6.5: Summary AI（独立切片，与 Copilot 的 AI_* 无关）docs/P6/P6.5-summary-ai-slice.md ---
# GET /summary-ai/conversations/:conversationId — JWT + 会话参与者校验；失败仍 200 + 规则占位摘要。
# SUMMARY_AI_ENABLED=0
# SUMMARY_AI_PROVIDER=deepseek
# SUMMARY_AI_BASE_URL=https://api.deepseek.com
# SUMMARY_AI_MODEL=deepseek-chat
# SUMMARY_AI_API_KEY=
# SUMMARY_AI_TIMEOUT_MS=25000

# --- P6.6: Match Explanation AI（独立切片；与 AI_*、SUMMARY_AI_* 无关）docs/P6/P6.6-match-explanation-ai-slice.md ---
# GET /match-explanation-ai/match-results/:matchResultId — JWT，仅 matchResult.userId 与 token 一致；模型失败仍 200 + 规则占位。
# MATCH_EXPLANATION_AI_ENABLED=0
# MATCH_EXPLANATION_AI_PROVIDER=deepseek
# MATCH_EXPLANATION_AI_BASE_URL=https://api.deepseek.com
# MATCH_EXPLANATION_AI_MODEL=deepseek-chat
# MATCH_EXPLANATION_AI_API_KEY=
# MATCH_EXPLANATION_AI_TIMEOUT_MS=25000

# --- Auth / JWT (future) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Comma or whitespace separated user ids (JWT sub) allowed for GET /analytics/p2-overview. Empty = no access.
P2_ANALYTICS_GLOBAL_OVERVIEW_USER_IDS=

# Admin UI (e.g. Matching 页「立刻执行 batch-match」). Empty = no one. Same ids as JWT user id (cuid).
# PEIMA_ADMIN_USER_IDS=

# Set to 1 to hide/disable admin batch-match trigger even for allowlisted users.
# PEIMA_ADMIN_BATCH_MATCH_DISABLED=

# If API cwd is not apps/api, set absolute path to monorepo root (folder containing apps/worker).
# PEIMA_MONOREPO_ROOT=

# Subprocess timeout for admin batch-match (ms).
# PEIMA_ADMIN_BATCH_MATCH_TIMEOUT_MS=180000

# --- Test-only: web button "立即做一次匹配" on /matching-waiting (same subprocess as admin) ---
# PEIMA_TEST_MATCH_ENABLED=1
# PEIMA_TEST_MATCH_USER_IDS=<same cuid as JWT user id, comma-separated>
# PEIMA_TEST_MATCH_DISABLED=1
