# =============================================================================
# Peima monorepo — environment template (no real secrets; copy to `.env`).
# Keys mirror `process.env` / `import.meta.env` / docker-compose interpolation.
# Markers: [required] = minimal local/docker run; [optional] = feature flags / dev helpers.
# =============================================================================

# --- 1) Core / server [required for API] ---
NODE_ENV=development
TZ=Asia/Shanghai
API_PORT=3000
API_HOST=0.0.0.0
# [optional] Log registered routes on boot (`1` to enable).
# API_LOG_ROUTES=

# --- 2) Database / Docker [required for API + worker + Prisma] ---
DATABASE_URL=postgresql://user:password@localhost:5432/peima?schema=public
# docker-compose: containers use hostname `postgres` instead of localhost.
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=peima
DOCKER_DATABASE_URL=postgresql://user:password@postgres:5432/peima?schema=public

# --- 3) Auth / JWT [required for API auth + WS] ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- 4) Web / Admin (Vite) [required for browser → API routing] ---
# Must point at the Nest API origin (not the Vite dev server port).
VITE_API_BASE_URL=http://localhost:3000
WEB_PORT=5173
# [optional] M6.0-H2: FinalMatchPage 主视觉使用 V2 displayScore100（`1` 开启；未设置或其它值则 legacy finalScore）。
# VITE_FINAL_MATCH_USE_V2_PRIMARY_SCORE=1
# [optional] Preview pool orchestration chain (web only).
# VITE_PREVIEW_POOL_ORCH_CHAIN_RUN_JOB=
# VITE_PREVIEW_POOL_ORCH_RUN_JOB_TIMEOUT_MS=

# --- 5) Uploads / public URLs [optional; defaults under apps/api when unset] ---
# UPLOAD_DIR=
# Browser-reachable API origin for stored user image URLs (reverse proxy / Docker).
# API_PUBLIC_BASE_URL=

# --- 6) Preview pool visual / image-style LLM (no separate FACE_* env in code) ---
# Rank1–2 visual ordering stub/LLM; see docs/P6/specs/P6-preview-pool-visual-signal-enhancement-v0.md
# [optional] All keys below default to safe stub/off paths when unset.
# PEIMA_PREVIEW_VISUAL_ENHANCE_ENABLED=0
# PEIMA_PREVIEW_VISUAL_ENHANCE_PROVIDER=stub
# PEIMA_PREVIEW_VISUAL_ENHANCE_LLM_BASE_URL=
# PEIMA_PREVIEW_VISUAL_ENHANCE_LLM_API_KEY=
# PEIMA_PREVIEW_VISUAL_ENHANCE_LLM_MODEL=
# PEIMA_PREVIEW_VISUAL_ENHANCE_LLM_TIMEOUT_MS=
# PEIMA_PREVIEW_VISUAL_ENHANCE_TIMEOUT_MS=
# PEIMA_PREVIEW_VISUAL_ENHANCE_CACHE_TTL_MS=

# --- 7) P6: Copilot LLM (OpenAI-compatible POST /v1/chat/completions) ---
# Runbook: docs/P6/specs/P6.2-copilot-llm-runbook.md
# [optional] When off or misconfigured, API returns rule-based fallback (still 200 where specified).
# AI_COPILOT_ENABLED=0
# AI_PROVIDER=
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
# AI_TIMEOUT_MS=25000

# --- 8) P6.5: Summary AI (independent from Copilot `AI_*`) ---
# [optional] docs/P6/specs/P6.5-summary-ai-slice.md
# SUMMARY_AI_ENABLED=0
# SUMMARY_AI_PROVIDER=
# SUMMARY_AI_BASE_URL=
# SUMMARY_AI_MODEL=
# SUMMARY_AI_API_KEY=
# SUMMARY_AI_TIMEOUT_MS=25000

# --- 9) P6.6: Match explanation AI ---
# [optional] docs/P6/specs/P6.6-match-explanation-ai-slice.md
# MATCH_EXPLANATION_AI_ENABLED=0
# MATCH_EXPLANATION_AI_PROVIDER=
# MATCH_EXPLANATION_AI_BASE_URL=
# MATCH_EXPLANATION_AI_MODEL=
# MATCH_EXPLANATION_AI_API_KEY=
# MATCH_EXPLANATION_AI_TIMEOUT_MS=25000

# --- 10) P6.x: Match review AI (also fallback for AI Simulation v1 when sim-specific URL/key unset) ---
# [optional] POST /match-review-ai/review — JWT; no persistence.
# MATCH_REVIEW_AI_ENABLED=0
# MATCH_REVIEW_AI_PROVIDER=
# MATCH_REVIEW_AI_BASE_URL=
# MATCH_REVIEW_AI_MODEL=
# MATCH_REVIEW_AI_API_KEY=
# MATCH_REVIEW_AI_TIMEOUT_MS=25000

# --- 11) M3: AI Simulation v1 (enqueue + worker consumer; DB-backed queue) ---
# [optional] POST /run enqueues; worker package consumes when enabled.
# AI_SIMULATION_V1_ENABLED=0
# AI_SIMULATION_V1_BASE_URL=
# AI_SIMULATION_V1_API_KEY=
# AI_SIMULATION_V1_MODEL=
# AI_SIMULATION_V1_MAX_TOKENS=8000
# AI_SIMULATION_V1_TIMEOUT_MS=60000
# Worker (`apps/worker` + `@peima/ai-simulation-v1-runner`): poll + stuck recovery (M3.3).
# AI_SIMULATION_V1_WORKER_ENABLED=0
# AI_SIMULATION_V1_WORKER_POLL_MS=10000
# AI_SIMULATION_V1_STUCK_TIMEOUT_MS=900000
# AI_SIMULATION_V1_RECOVERY_POLL_MS=60000

# --- M3.8-M2: RRM-lite pairwise decision LLM (independent from AI_SIMULATION_V1_*; default off) ---
# [optional] `AiPairwiseDecisionService.generateAiPairwiseDecision`; no DB persistence in M3.8-M2.
# AI_PAIRWISE_DECISION_ENABLED=0
# AI_PAIRWISE_DECISION_PROVIDER=deepseek
# AI_PAIRWISE_DECISION_BASE_URL=https://api.deepseek.com
# AI_PAIRWISE_DECISION_API_KEY=
# AI_PAIRWISE_DECISION_MODEL=deepseek-v4-flash
# AI_PAIRWISE_DECISION_TIMEOUT_MS=90000
# AI_PAIRWISE_DECISION_MAX_TOKENS=2500
# Optional: OpenAI-style response_format json_object (not all providers support it).
# AI_PAIRWISE_DECISION_JSON_OBJECT_MODE=0

# Worker (`apps/worker` + `@peima/ai-pairwise-decision-runner`): M3.8-M4A poll + stuck recovery (default off).
# Requires AI_PAIRWISE_DECISION_ENABLED=1 and AI_PAIRWISE_DECISION_WORKER_ENABLED=1 to consume jobs.
# AI_PAIRWISE_DECISION_WORKER_ENABLED=0
# AI_PAIRWISE_DECISION_WORKER_POLL_MS=10000
# AI_PAIRWISE_DECISION_STUCK_TIMEOUT_MS=900000
# AI_PAIRWISE_DECISION_RECOVERY_POLL_MS=60000

# --- M3.8-M11: finalize-with-pairwise sidecar (`POST /matching/finalize-with-pairwise`; default off / proposal_only) ---
# Does not change `MatchResult.candidateUserId` or `finalScore`. `MODE=enabled` returns `disabled` until a later milestone.
# PAIRWISE_FINAL_MATCH_ENABLED=0
# PAIRWISE_FINAL_MATCH_MODE=proposal_only
# PAIRWISE_FINAL_MATCH_MIN_CONFIDENCE=0.6
# PAIRWISE_FINAL_MATCH_MIN_SCORE_GAP=5
# PAIRWISE_FINAL_MATCH_TIMEOUT_MS=90000
# PAIRWISE_FINAL_MATCH_SOURCE_VERSION=m3.8-pairwise-finalize-v1

# --- M1.3-M12 D_pre static lift cap shadow (offline / `m13-m0-calibration-simulator --includeDebug` only; default off) ---
# Does not change production `rrmSimResult`; viewer APIs must not expose this block.
# RRM_D_PRE_CALIBRATION_ENABLED=0
# RRM_D_PRE_CALIBRATION_MODE=shadow
# RRM_D_PRE_STATIC_LIFT_CAP=0.25
# RRM_D_PRE_CALIBRATION_VERSION=m1.3-d-pre-static-lift-cap-v1

# --- 12) P6.y: Interaction simulation lite ---
# [optional] docs/P6/specs/P6.y-interaction-simulation-lite.md
# INTERACTION_SIMULATION_LITE_ENABLED=0
# INTERACTION_SIMULATION_LITE_PROVIDER=
# INTERACTION_SIMULATION_LITE_BASE_URL=
# INTERACTION_SIMULATION_LITE_MODEL=
# INTERACTION_SIMULATION_LITE_API_KEY=
# INTERACTION_SIMULATION_LITE_TIMEOUT_MS=25000

# --- 13) P6.8: Profile completion AI (chat POST; pending suggestions) ---
# [optional] Independent from `SUMMARY_AI_*`.
# PROFILE_COMPLETION_AI_ENABLED=0
# PROFILE_COMPLETION_AI_BASE_URL=
# PROFILE_COMPLETION_AI_MODEL=
# PROFILE_COMPLETION_AI_API_KEY=
# PROFILE_COMPLETION_AI_TIMEOUT_MS=25000

# --- 14) Worker / cron (daily batch hook) ---
# [optional] Cron expression for scheduled work (`apps/worker` scheduler).
MATCH_CRON="0 20 * * *"

# --- 15) Admin / RBAC allowlists (JWT `sub` / user id, comma-separated) ---
# [optional] Admin batch-match, GET /admin/matching-observability/summary (M4.4-M2 / P7.11-r1), notification gateway.
# PEIMA_ADMIN_USER_IDS=
# PEIMA_ADMIN_BATCH_MATCH_DISABLED=
# PEIMA_ADMIN_BATCH_MATCH_TIMEOUT_MS=180000
# [optional] RBAC seeding / Admin UI operator & analyst roles (see `rbac.service.ts`).
# PEIMA_OPERATOR_USER_IDS=
# PEIMA_DATA_ANALYST_USER_IDS=
# [optional] Dev-only: skip RBAC DB init when truthy.
# PEIMA_RBAC_SKIP_DB_INIT=
# [optional] When API cwd is not `apps/api`, absolute path to monorepo root (contains `apps/worker`).
# PEIMA_MONOREPO_ROOT=

# --- 15b) Testing observability (local/staging debug monitor) ---
# [optional] When not "1", all GET/POST /admin/testing-observability/* return 404.
# PEIMA_TEST_OBSERVABILITY_ENABLED=0
# [optional] When set, requests must send header x-peima-debug-token with this value.
# PEIMA_TEST_OBSERVABILITY_TOKEN=local-dev-only

# --- 16) Analytics ---
# [optional] Comma/whitespace-separated user ids allowed for GET /analytics/p2-overview (global).
P2_ANALYTICS_GLOBAL_OVERVIEW_USER_IDS=

# --- 17) Web test hook: “立即做一次匹配” ---
# [optional] Same subprocess entry as admin batch-match; see `test-match.policy.ts`.
# PEIMA_TEST_MATCH_ENABLED=
# PEIMA_TEST_MATCH_USER_IDS=
# PEIMA_TEST_MATCH_DISABLED=

# --- 17b) Matching: M5.2-M0 shadow **contract** on GET /matching/result (no shadow decision, no DB) ---
# [optional] When true, `multiSourceFinalDecision.mode` is `shadow` and shadow block is populated; display fields unchanged.
# PEIMA_M5_FINAL_DECISION_SHADOW_ENABLED=false

# --- 17c) Matching: M5.2-M2B viewer-safe `rrmSimReadonlySummary` DB write (default off) ---
# [optional] When true, `writeRrmSimReadonlySummaryToMatchResult` may persist only `matchInsights.rrmSimReadonlySummary` (no display / score / candidate changes).
# PEIMA_M5_RRM_SIM_READONLY_SUMMARY_WRITE_ENABLED=false

# --- 17d) Matching: M5.5-M2 `MatchResultRrmTop2DisplayMeta` controlled writer (default off) ---
# [optional] When true, `writeRrmTop2DisplayMetaForMatchResult` may upsert RRM Top2 display sidecar (not wired to GET/worker in M5.5-M2).
# PEIMA_M5_RRM_TOP2_META_WRITE_ENABLED=false

# --- 18) packages/database maintenance scripts [optional] ---
# IMPORT_TEST_IMAGES_DIR=
# IMPORT_TEST_MAPPING_PATH=
# PUBLIC_BASE_URL=http://127.0.0.1:3000
# BIND_TEST_IMAGES_APPLY=
# BIND_TEST_IMAGES_DIR=
# VIEWER_USER_ID=

# --- 19) Legacy / reserved (not read by apps/api or apps/worker today) ---
# [optional] P5 architecture notes mentioned queues; no runtime consumer in this repo yet.
REDIS_URL=redis://localhost:6379
# [optional] Historical placeholder; Copilot uses `AI_*` / `AI_COPILOT_*` instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- 20) README / docs historical (no `FINAL_MATCH_CONCLUSION_AI_*` in apps/api as of env audit) ---
# [optional] Legacy names from README narrative; keep only if you maintain an external fork that still reads them.
# FINAL_MATCH_CONCLUSION_AI_ENABLED=
# FINAL_MATCH_CONCLUSION_AI_PROVIDER=
# FINAL_MATCH_CONCLUSION_AI_BASE_URL=
# FINAL_MATCH_CONCLUSION_AI_MODEL=
# FINAL_MATCH_CONCLUSION_AI_API_KEY=

# --- 21) P7.5: Onboarding vision profile + visual ranking shadow (local QA / staging) ---
# docs/P7/P7.5-r4-e-visual-ranking-shadow-sample-signoff.md
# Shadow persists to `OnboardingPhotoPreviewPoolShadow`; does not change viewer-visible pool items.
#
# Core vision (read by `readOnboardingVisionEnv`):
# PEIMA_ONBOARDING_VISION_ENABLED=1
# PEIMA_ONBOARDING_VISION_PROVIDER=rules
# PEIMA_ONBOARDING_VISION_SHADOW_ENABLED=1
#
# P7.5-r5-b+ apply gate (read by `readOnboardingVisionApplyEnv`; only "1" enables the gate — not "true"):
# PEIMA_ONBOARDING_VISION_APPLY_TO_POOL=0
# PEIMA_ONBOARDING_VISION_APPLY_ALLOWLIST_USER_IDS=
# PEIMA_ONBOARDING_VISION_APPLY_PERCENT=0
# PEIMA_ONBOARDING_VISION_APPLY_SOURCE_VERSION=onboarding-photo-preview-v2-vision
