# =============================================================================
# VPS 内测完整 .env（170.64.132.63）— 由 env.txt + 线上库/JWT 合并
# 含真实 API Key，勿提交 Git / 勿发到公开群。
#
# 上传到 VPS（PowerShell）:
#   scp "C:\Users\Linye\OneDrive\Documents\配吗\Peima\docs\ops\vps-deploy-170.64.132.63.env" root@170.64.132.63:~/Peima/.env
#
# VPS 上:
#   sed -i 's/\r$//' ~/Peima/.env
#   cd ~/Peima && git pull origin frontend
#   docker compose -f docker-compose.beta.yml build --no-cache
#   docker compose -f docker-compose.beta.yml up -d
#   # 若只有 docker-compose v1: docker-compose -f docker-compose.beta.yml ...
#
# migrate（用 Session 5432，不要用 6543）:
#   DATABASE_URL='postgresql://...@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres' bash scripts/beta-migrate.sh
# =============================================================================
# LLM 分工（与本地 env.txt 一致）:
#   DeepSeek — RRM / AI Simulation v1 / Pairwise
#   Kimi     — Copilot / Summary / Profile Completion / 部分 Match Review
#   Zhipu    — 人像 / onboarding vision
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Core / server（线上）
# -----------------------------------------------------------------------------
