TZ=Australia/Sydney

API_PORT=3000
API_HOST=0.0.0.0
API_LOG_ROUTES=0

WEB_PORT=5173

# -----------------------------------------------------------------------------
# 2) Database（API 运行用 Transaction pooler 6543 + pgbouncer）
