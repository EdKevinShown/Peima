# =============================================================================
# VPS 内测完整 .env（170.64.132.63）— 整文件复制到服务器 ~/Peima/.env
# 含真实 API Key，勿提交 Git / 勿发到公开群。
#
# ── 一键上传（在你电脑 PowerShell）────────────────────────────────────────
#   scp "C:\Users\Linye\OneDrive\Documents\配吗\Peima\docs\ops\vps-deploy-170.64.132.63.env" root@170.64.132.63:~/Peima/.env
#
# ── VPS 上（SSH）──────────────────────────────────────────────────────────
#   sed -i 's/\r$//' ~/Peima/.env
#   cd ~/Peima && git pull origin frontend
#   docker-compose -f docker-compose.beta.yml build --no-cache api web worker
#   docker-compose -f docker-compose.beta.yml up -d --force-recreate api worker web
#   docker-compose -f docker-compose.beta.yml ps
#
#   # 验收 env 是否进容器：
#   docker exec peima-beta-api printenv | grep -E "OBSERVABILITY|ONBOARDING_PREVIEW_RELAX"
#   docker exec peima-beta-worker printenv | grep -E "TEST_MATCH_RESULT|NODE_ENV"
#
# migrate（Session 5432，不要用 6543）:
#   DATABASE_URL='postgresql://...@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres' bash scripts/beta-migrate.sh
# =============================================================================
# 2026-06-03 相对旧 VPS .env 新增/务必有：
#   PEIMA_TEST_OBSERVABILITY_ENABLED=1
#   PEIMA_TEST_MATCH_RESULT_WRITER_ENABLED=1
#   PEIMA_ONBOARDING_PREVIEW_RELAX_* + MIN_SLOTS=3
#   docker-compose.beta.yml 里 worker NODE_ENV=staging（否则匹配写不出 MatchResult）
# =============================================================================
# LLM 分工:
#   DeepSeek — RRM / AI Simulation v1 / Pairwise
#   Kimi     — Copilot / Summary / Profile Completion / 部分 Match Review
#   Zhipu    — 人像 / onboarding vision
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Core / server
# -----------------------------------------------------------------------------
NODE_ENV=production
TZ=Australia/Sydney

API_PORT=3000
API_HOST=0.0.0.0
API_LOG_ROUTES=0

WEB_PORT=5173

# -----------------------------------------------------------------------------
# 2) Database（API/Worker 运行：Transaction pooler 6543 + pgbouncer）
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.dvlwvwwnxwvdvuywjuqs:UGEVdGkcfmPvnPAy@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# 3) Auth / JWT
# -----------------------------------------------------------------------------
JWT_SECRET=625b155b2880e0f1bb4506dd09b4428638083438e3ec18b405c24ef2bd84ae68
JWT_EXPIRES_IN=7d

# Production API (NODE_ENV=production) requires explicit browser origins — no wildcard.
PEIMA_CORS_ALLOWED_ORIGINS=http://170.64.132.63:5173,http://170.64.132.63:3000

# -----------------------------------------------------------------------------
# 4) Upload / public URLs
# -----------------------------------------------------------------------------
UPLOAD_DIR=/data/uploads/user-images
API_PUBLIC_BASE_URL=http://170.64.132.63:3000
PUBLIC_BASE_URL=http://170.64.132.63:3000
VITE_API_BASE_URL=http://170.64.132.63:3000

VITE_FINAL_MATCH_USE_V2_PRIMARY_SCORE=1
VITE_PREVIEW_POOL_ORCH_CHAIN_RUN_JOB=0
VITE_PREVIEW_POOL_ORCH_RUN_JOB_TIMEOUT_MS=180000

# -----------------------------------------------------------------------------
# 5) 内测开关 / P7.6
# -----------------------------------------------------------------------------
PEIMA_P76_READ_PATH_ENABLED=0
PEIMA_P76_PRODUCTION_KILL_SWITCH=1
PEIMA_P76_PRODUCTION_PERCENT_ENABLED=0
PEIMA_P76_PRODUCTION_PERCENT=0

# -----------------------------------------------------------------------------
# 6) Admin / 测试匹配 / 测试监视器 / 第一印象预览池门闸
# -----------------------------------------------------------------------------
PEIMA_ADMIN_USER_IDS=cmpxtd4o4000tpd0j8qgsm3m1
PEIMA_ADMIN_BATCH_MATCH_DISABLED=0
PEIMA_ADMIN_BATCH_MATCH_TIMEOUT_MS=180000
PEIMA_OPERATOR_USER_IDS=
PEIMA_DATA_ANALYST_USER_IDS=
PEIMA_RBAC_SKIP_DB_INIT=0
PEIMA_MONOREPO_ROOT=

# 网页「测试跑一轮」按钮：仅下列账号可点（管理员还可用「立即跑一轮」处理全员队列）
PEIMA_TEST_MATCH_ENABLED=1
PEIMA_TEST_MATCH_USER_IDS=cmpxtd4o4000tpd0j8qgsm3m1
PEIMA_TEST_MATCH_DISABLED=0

# Worker 写入 MatchResult：队列里任意 viewer 都可写出结果（不限 WRITER_USER_IDS 白名单）
# 候选人来自各用户 preview_pools 池内条目，不按 userId 白名单筛人
PEIMA_TEST_MATCH_RESULT_WRITER_ENABLED=1
PEIMA_TEST_MATCH_RESULT_WRITER_DISABLED=0
PEIMA_TEST_MATCH_RESULT_WRITER_OPEN_FOR_ALL=1
PEIMA_TEST_MATCH_RESULT_WRITER_USER_IDS=
# 网页「跑一轮」在 API 子进程执行；设为 staging 才能写入 MatchResult（也可不设，代码在 WRITER_ENABLED=1 时自动 staging）
PEIMA_BATCH_MATCH_SUBPROCESS_NODE_ENV=staging

# 测试监视器 /admin/testing-observability（管理员 JWT 可访问；生产 NODE_ENV 仍须配置强 token）
PEIMA_TEST_OBSERVABILITY_ENABLED=1
PEIMA_TEST_OBSERVABILITY_TOKEN=a7f3c2e8910b4d6e8f2a1c5b9e7d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6

# 可选：测试种子老 preview_pools（一般不用）
PEIMA_TEST_PREVIEW_POOL_SEED_ENABLED=0
PEIMA_TEST_PREVIEW_POOL_SEED_DISABLED=0
PEIMA_TEST_PREVIEW_POOL_SEED_USER_IDS=cmpxtd4o4000tpd0j8qgsm3m1

# 第一印象 onboarding 预览：放宽门闸（性别门闸不可关闭，仅异性进池）
PEIMA_ONBOARDING_PREVIEW_RELAX_PROFILE_GATE=1
PEIMA_ONBOARDING_PREVIEW_RELAX_GENDER_GATE=0
PEIMA_ONBOARDING_PREVIEW_RELAX_PREFERENCE_GATE=1
PEIMA_ONBOARDING_PREVIEW_MIN_SLOTS=3

P2_ANALYTICS_GLOBAL_OVERVIEW_USER_IDS=cmpxtd4o4000tpd0j8qgsm3m1,cmo7ksq8s00006znosryc9k0n

# -----------------------------------------------------------------------------
