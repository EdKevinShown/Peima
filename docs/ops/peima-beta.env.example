# =============================================================================
# Peima 澳洲 IP 内测 — 复制到仓库根目录并重命名为 `.env`
#   cp docs/ops/peima-beta.env.example .env
# 把 YOUR_VPS_IP 换成悉尼 VPS 公网 IP。勿提交真实 .env。
# =============================================================================

NODE_ENV=production
TZ=Australia/Sydney

API_PORT=3000
API_HOST=0.0.0.0
WEB_PORT=5173

# [必填] 托管 Postgres（悉尼/近澳），仅允许 VPS IP 访问
DATABASE_URL=postgresql://USER:PASSWORD@db-host.example:5432/peima?schema=public

# [必填] openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# [必填] 用户浏览器能访问到的 API 根地址（无域名时用 IP）
API_PUBLIC_BASE_URL=http://YOUR_VPS_IP:3000
VITE_API_BASE_URL=http://YOUR_VPS_IP:3000

UPLOAD_DIR=/data/uploads/user-images

# 内测保守默认（与 staging 一致，可先不改）
PEIMA_P76_READ_PATH_ENABLED=0
PEIMA_P76_PRODUCTION_KILL_SWITCH=1

# [可选] 你的 userId，逗号分隔，用于 admin 批匹配等
# PEIMA_ADMIN_USER_IDS=

# [可选] Worker 定时匹配 cron（默认每 6 小时）
# MATCH_CRON=0 */6 * * *

# AI 功能默认关闭即可；需要时再按 .env.example 逐项开启
