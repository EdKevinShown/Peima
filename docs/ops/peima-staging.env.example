# =============================================================================
# Peima staging / production-like environment — TEMPLATE ONLY
# Copy to `.env.staging` (gitignored). Never commit real secrets.
# Runbook: docs/P7/P7.6-r9e4-staging-production-like-environment-bootstrap-runbook.md
# =============================================================================

# --- Core API [required] ---
NODE_ENV=production
TZ=Asia/Shanghai
API_PORT=3000
API_HOST=0.0.0.0

# [required] Managed Postgres — host MUST NOT be localhost
DATABASE_URL=postgresql://<user>:<password>@<staging-host>:5432/peima?schema=public

# [required] Generate per environment (min 32 chars)
JWT_SECRET=<generate-strong-secret>
JWT_EXPIRES_IN=7d

# --- Uploads [recommended] ---
UPLOAD_DIR=/data/uploads/user-images
API_PUBLIC_BASE_URL=https://api-staging.<your-domain>

# --- P7.6 allowlist read path — BOOTSTRAP FREEZE (do not change on first deploy) ---
PEIMA_P76_READ_PATH_ENABLED=0
PEIMA_P76_READ_PATH_VIEWER_IDS=
PEIMA_P76_READ_PATH_SOURCE_VERSION=p7.6-r7j3-staging-cohort-v1
PEIMA_P76_READ_PATH_REQUIRE_PM_SIGNOFF=1
PEIMA_P76_READ_PATH_REQUIRE_OPS_SIGNOFF=1
# Safe fallback to baseline display when sidecar ineligible (not photo matching).
PEIMA_P76_READ_PATH_SAFE_FALLBACK=1
# Deprecated alias for PEIMA_P76_READ_PATH_SAFE_FALLBACK. Do not use for new environments.
PEIMA_P76_READ_PATH_FALLBACK_LEGACY=1
PEIMA_P76_READ_PATH_STRICT_VIOLATION_BLOCK=1
# P7.10-r4a: additive GET /matching/result resultState (default off)
# PEIMA_P76_RESULT_STATE_CONTRACT_ENABLED=0
PEIMA_P76_PRODUCTION_PERCENT_ENABLED=0
PEIMA_P76_PRODUCTION_PERCENT=0
PEIMA_P76_PRODUCTION_KILL_SWITCH=1

# --- Web build [required if deploying apps/web] ---
VITE_API_BASE_URL=https://api-staging.<your-domain>

# --- Optional: worker (skip for P7.6 r9e3 minimal staging) ---
# MATCH_CRON=0 0 * * *
# AI_MATCH_REVIEW_WORKER_ENABLED=0

# --- Optional: admin batch-match ---
# PEIMA_ADMIN_USER_IDS=

# --- NOT FOR BOOTSTRAP — controlled r9e3 window only (Ops applies via secret manager) ---
# PEIMA_P76_READ_PATH_ENABLED=1
# PEIMA_P76_READ_PATH_VIEWER_IDS=cmr4hm001016z64demo00m05a,cmfemn00100016z64seed0001,...
# PEIMA_P76_PRODUCTION_KILL_SWITCH=0
