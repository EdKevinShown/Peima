// Peima — database schema
// Migrations: pnpm --filter @peima/database db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User profile (no auth in this iteration — phone is the natural key).
model User {
  id               String   @id @default(cuid())
  phone            String   @unique
  nickname         String
  gender           String   @default("")
  age              Int?
  city             String   @default("")
  height           Int?
  education        String   @default("")
  occupation       String   @default("")
  relationshipGoal String   @default("")
  bio              String   @default("") @db.Text
  /// P7.2: set when user submits onboarding aesthetic tags (not inferred from legacy styleTags).
  onboardingPhotoAestheticCompletedAt DateTime?
  /// P7.2: set when user acknowledges onboarding photo preview ("继续完成关系画像"); gates questionnaire.
  onboardingPhotoPreviewCompletedAt   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  preference                   UserPreference?
  images                       UserImage[]
  previewPools                 PreviewPool[]
  previewPoolItemsAsViewer     PreviewPoolItem[] @relation("PreviewPoolItemViewer")
  previewPoolItemsAsCandidate  PreviewPoolItem[] @relation("PreviewPoolItemCandidate")
  questionnaireAnswers         QuestionnaireAnswer[]
  relationProfile              UserProfile?
  matchQueueEntries            BatchMatchQueue[]
  matchResultsAsViewer         MatchResult[]       @relation("MatchResultViewer")
  matchResultsAsCandidate      MatchResult[]       @relation("MatchResultCandidate")
  conversationEntriesAsViewer Conversation[] @relation("ConversationViewer")
  conversationEntriesAsCandidate Conversation[] @relation("ConversationCandidate")
  friendshipsOwned  UserFriendship[] @relation("FriendshipOwner")
  friendshipsAsPeer UserFriendship[] @relation("FriendshipPeer")
  messagesAsSender Message[] @relation("MessageSender")
  structuredFeedbacks      UserFeedback[]
  profileUpdateSuggestions ProfileUpdateSuggestion[]
  behaviorSignals          BehaviorSignal[]
  suggestionHistoryChanges SuggestionHistory[] @relation("SuggestionHistoryChangedBy") // P5：历史变更记录
  auditLogs                AuditLog[] // P5 Phase 2：审计日志记录
  rolesAssigned            UserRole[] @relation("UserRolesAssigned") // P5 Phase 2.2：分配给该用户的角色
  rolesGrantedByMe         UserRole[] @relation("UserRolesGrantedBy") // P5 Phase 2.2：由该用户授予的角色
  notifications            Notification[] // P5 Phase 2.3：通知记录
  aiSimulationV1Jobs       AiSimulationV1Job[] // P6：AI 模拟 v1（侧车，不写 MatchResult）
  /// M3.8-M3：RRM-lite pairwise decision job（独立语义；不写 MatchResult）。
  aiPairwiseDecisionJobs   AiPairwiseDecisionJob[]
  /// M3.8-M11：finalize-with-pairwise sidecar（不写 MatchResult.candidateUserId / 不改 finalScore）。
  pairwisePoolFinalizeMeta PairwisePoolFinalizeMeta[]
  /// M5.3-C1：RRM Top2 display 侧车（不写 MatchResult.candidateUserId / 不改 finalScore）。
  matchResultRrmTop2DisplayMeta MatchResultRrmTop2DisplayMeta[]
  /// M5.6-B1：RRM Top2 display hook outbox rows（durable intent；consumer 未接）。
  matchResultRrmTop2DisplayHookJobs MatchResultRrmTop2DisplayHookJob[]
  chatProfileEvidence      ChatProfileEvidence[] // P6：聊天补全画像证据层 v1（accept 入账；不接主匹配）
  /// P7.2: onboarding-only photo preview pools (never read by batch-match worker).
  onboardingPhotoPreviewPools OnboardingPhotoPreviewPool[]
  onboardingPhotoPreviewPoolItemsAsViewer OnboardingPhotoPreviewPoolItem[] @relation("OnboardingPhotoPreviewPoolItemViewer")
  onboardingPhotoPreviewPoolItemsAsCandidate OnboardingPhotoPreviewPoolItem[] @relation("OnboardingPhotoPreviewPoolItemCandidate")
  /// P7.5-r4: readonly visual ranking shadow rows (hypothetical 3+2+1; never applied to items in r4).
  onboardingPhotoPreviewPoolShadows OnboardingPhotoPreviewPoolShadow[]
  /// P7.6-r8b: Route C allowlist apply sidecar (never writes MatchResult / finalScore / worker / display).
  p76AllowlistApplyMeta P76AllowlistApplyMeta[]

  @@map("users")
}

/// P7.2: viewer onboarding photo preview (3+2+1); isolated from `PreviewPool` / worker.
model OnboardingPhotoPreviewPool {
  id            String   @id @default(cuid())
  userId        String
  status        String
  sourceVersion String   @default("onboarding-photo-preview-v1")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   OnboardingPhotoPreviewPoolItem[]
  shadows OnboardingPhotoPreviewPoolShadow[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@map("onboarding_photo_preview_pools")
}

/// P7.5-r4: readonly shadow payload for onboarding photo preview pool (audit / ops; not viewer-facing).
model OnboardingPhotoPreviewPoolShadow {
  id            String   @id @default(cuid())
  poolId        String
  userId        String
  shadowType    String
  sourceVersion String
  payloadJson   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pool OnboardingPhotoPreviewPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  user User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poolId, shadowType, sourceVersion])
  @@index([userId, createdAt(sort: Desc)])
  @@index([shadowType, createdAt(sort: Desc)])
  @@index([poolId])
  @@map("onboarding_photo_preview_pool_shadows")
}

model OnboardingPhotoPreviewPoolItem {
  id              String   @id @default(cuid())
  poolId          String
  userId          String
  candidateUserId String
  tier            String
  displayMode     String
  rankInPool      Int
  score           Float?
  reasonTags      String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pool      OnboardingPhotoPreviewPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  viewer    User                       @relation("OnboardingPhotoPreviewPoolItemViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate User                       @relation("OnboardingPhotoPreviewPoolItemCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([poolId, rankInPool])
  @@index([poolId])
  @@index([userId, poolId])
  @@map("onboarding_photo_preview_pool_items")
}

/// Partner / filter preferences for matching (one row per user; extend with new scalar/array columns or JSON later).
model UserPreference {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  minAge                      Int?
  maxAge                      Int?
  preferredCities             String[] @default([])
  minHeight                   Int?
  maxHeight                   Int?
  educationPreferences        String[] @default([])
  occupationPreferences       String[] @default([])
  relationshipGoalPreferences String[] @default([])
  styleTags                   String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// User photo metadata + analysis snapshot (URL assumed already hosted; no binary stored here).
model UserImage {
  id                    String    @id @default(cuid())
  userId                String
  imageUrl              String
  faceEmbedding         Json?
  attractivenessScore   Float?
  styleTags             String[]  @default([])
  ageEstimate           Int?
  genderEstimate        String?
  confidence            Float?
  /// P7.4-r1a: pending | passed | failed | skipped (legacy rows default skipped)
  detectionStatus       String    @default("skipped")
  detectionReasonCodes  String[]  @default([])
  detectionScoreJson    Json?
  detectionRulesVersion String?
  detectedAt            DateTime?
  /// P7.4-r1d-b: human/ops review (separate from machine detectionStatus)
  reviewStatus          String    @default("not_required")
  reviewReasonCodes     String[]  @default([])
  reviewedAt            DateTime?
  reviewedByUserId      String?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, detectionStatus, createdAt])
  @@index([reviewStatus, createdAt])
  @@index([userId, reviewStatus])
  @@map("user_images")
}

/// A generated 6-slot preview pool for one viewer user (P0: single active pool per user after latest generate).
model PreviewPool {
  id        String   @id @default(cuid())
  userId    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PreviewPoolItem[]

  @@map("preview_pools")
}

/// One candidate slot inside a preview pool (layered display: full / blurred / locked).
model PreviewPoolItem {
  id              String   @id @default(cuid())
  previewPoolId   String
  userId          String
  candidateUserId String
  candidateType   String
  displayMode     String
  rankInPool      Int
  baseScore       Float?
  itemMeta        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  previewPool PreviewPool @relation(fields: [previewPoolId], references: [id], onDelete: Cascade)
  viewer      User        @relation("PreviewPoolItemViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate   User        @relation("PreviewPoolItemCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@map("preview_pool_items")
}

/// AI 模拟 v1 job（pool 后深筛 hint → LLM transcript-lite + evaluator）；不写 MatchResult。
model AiSimulationV1Job {
  id                     String   @id @default(cuid())
  viewerUserId           String
  poolId                 String
  schemaVersion          String
  runSpecVersion         String
  hintSource             String
  hintSnapshot           Json
  /// Phase C v0: `{ previewPoolId, shortlistSchemaVersion, shortlistCandidateUserIds, shortlistFingerprint }` — must match `hintSnapshot` queue.
  shortlistBinding       Json?
  /// Phase C 第二步：shortlist 内 AI 决胜侧车（`shortlist_decision_v0`）；不写 MatchResult。
  shortlistDecisionV0    Json?
  /// Phase C v0.2：shortlist 固定四维比较侧车（`shortlist_four_dim_v0`）；不写 MatchResult。
  shortlistFourDimV0     Json?
  /// Phase C v0.3：shortlist 三场景证据侧车（`shortlist_scenarios_v0`）；不写 MatchResult。
  shortlistScenariosV0   Json?
  /// 与 `hintSnapshot` 解析后 Top-8 截断一致的有序 candidate user id 列表（JSON string[]）。
  simulationQueueActual Json
  jobStatus              String   @default("queued")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  viewer User                  @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)
  items  AiSimulationV1Item[]

  @@map("ai_simulation_v1_jobs")
}

model AiSimulationV1Item {
  id               String   @id @default(cuid())
  jobId            String
  candidateUserId  String
  status           String   @default("queued")
  attemptCount     Int      @default(0)
  transcriptLite   Json?
  evaluator        Json?
  /// First schema check failure when errorCode is schema_validation: { path, reason }.
  failureDetail    Json?
  errorCode        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  job AiSimulationV1Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("ai_simulation_v1_items")
}

/// M3.8-M3: RRM-lite pairwise decision job (isolated from `ai_simulation_v1_jobs`; no MatchResult / finalScore).
model AiPairwiseDecisionJob {
  id                   String    @id @default(cuid())
  viewerUserId         String
  poolId               String
  shortlistFingerprint String
  /// `queued` | `running` | `succeeded` | `failed`
  status               String    @default("queued")
  /// Contract era for reuse + result validation (e.g. `rrm-lite-pairwise-decision-v1`).
  sourceVersion        String
  shortlistSnapshot    Json
  decisionResult       Json?
  /// Safe structured failure (no API key, no raw LLM body, no full prompts).
  failureDetail        Json?
  fallbackUsed         Boolean?
  /// M3.8-M9: Phase-2 shadow final source (no MatchResult / no raw LLM / no scores in contract).
  finalSourceShadow    Json?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  viewer User @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@index([viewerUserId, poolId, shortlistFingerprint, sourceVersion, status])
  @@map("ai_pairwise_decision_jobs")
}

/// M3.8-M11: viewer-scoped finalize sidecar per pool (idempotent; frozen blocks late job swap).
model PairwisePoolFinalizeMeta {
  id             String    @id @default(cuid())
  viewerUserId   String
  poolId         String
  pairwiseJobId  String
  /// `FinalMatchDecisionMeta` v1 JSON (no raw scores / dimensions / strongRisk).
  meta           Json
  frozen         Boolean   @default(false)
  frozenAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  viewer User @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([viewerUserId, poolId])
  @@map("pairwise_pool_finalize_meta")
}

/// M5.3-C1: parallel sidecar for RRM Top2 bounded display decision (does not write MatchResult.candidateUserId / finalScore).
model MatchResultRrmTop2DisplayMeta {
  id              String    @id @default(cuid())
  matchResultId   String    @unique
  viewerUserId    String
  schemaVersion   Int
  sourceVersion   String
  top2Fingerprint String?
  frozen            Boolean   @default(true)
  frozenAt        DateTime?
  meta              Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  viewer      User        @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@index([viewerUserId])
  @@index([frozen, updatedAt])
  @@map("match_result_rrm_top2_display_meta")
}

/// M5.6-B1: durable outbox / hook job for RRM Top2 display writer intent (no GET/worker/consumer wiring in this milestone).
model MatchResultRrmTop2DisplayHookJob {
  id                      String    @id @default(cuid())
  matchResultId           String
  viewerUserId            String
  sourceVersion           String
  status                  String
  staticTop2Snapshot      Json
  top2Fingerprint         String
  rrmSourceType           String
  rrmSourceId             String?
  rrmSummarySourceVersion String?
  guardrails              Json
  noOpReasonCode          String?
  attempts                Int       @default(0)
  lastErrorCode           String?
  lastErrorMessage        String?   @db.Text
  lockedAt                DateTime?
  processedAt             DateTime?
  metaWriteResult         Json?
  auditMeta               Json?
  aiSimulationJobId       String?
  pairwiseJobId           String?
  poolId                  String?
  batchId                 String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  matchResult MatchResult @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  viewer      User        @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([matchResultId, top2Fingerprint, sourceVersion])
  @@index([status, createdAt])
  @@index([viewerUserId, status])
  @@index([matchResultId])
  @@index([rrmSourceType, rrmSourceId])
  @@map("match_result_rrm_top2_display_hook_jobs")
}

/// Single submission of lightweight relationship questionnaire answers (latest submit replaces rows in P0).
model QuestionnaireAnswer {
  id          String   @id @default(cuid())
  userId      String
  questionKey String
  answerValue String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("questionnaire_answers")
}

/// Derived relation-style profile from questionnaire (one row per user).
model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  socialEnergy        Float?
  emotionalExpression Float?
  relationshipPace    Float?
  initiativeLevel     Float?
  decisionOrientation Float?
  conflictResponse    Float?
  /// G1-R 轴 1–20（与 `G1R_PROFILE_KEYS` / `scoreQuestionnaireG1r` 一致）；`emotionalExpression` 与 legacy 列复用。
  attachmentStyle       Float?
  communicationStyle    Float?
  conflictHandling        Float?
  loveLanguage            Float?
  securityNeed            Float?
  controlNeed             Float?
  independence            Float?
  loyaltyView             Float?
  jealousyTendency        Float?
  moneyAttitude           Float?
  careerPriority          Float?
  lifePace                Float?
  socialNeed              Float?
  emotionalStability      Float?
  sexualValues            Float?
  familyView              Float?
  marriageExpectation     Float?
  childrenIntent          Float?
  riskPreference          Float?
  confidence          Float?
  /// Accepted P6.8 chat-based dimension-branch hints (supplement to questionnaire layer1; not answer SOT).
  dimensionBranchChatHints Json?
  /// P6 v1：问卷基线 + 聊天证据聚合后的最终生效画像派生视图（只读消费；不接 worker / finalScore）。
  effectiveProfileChatOverlayV1 Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

/// P6 v1：聊天补全 accept 产生的结构化证据（幂等 key userId+conversationId+axisId；ignore 不入库）。
model ChatProfileEvidence {
  id                     String    @id @default(cuid())
  userId                 String
  conversationId       String
  axisId                 Int
  branch                 String
  acceptedAt             DateTime
  sourceVersion          String
  suggestionId           String?
  acceptedByUser         Boolean   @default(true)
  sessionQualityBucket   String
  sessionQualityWeight   Float
  freshnessBucket        String
  freshnessWeight        Float
  evidenceWeight         Float
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId, axisId])
  @@index([userId, axisId])
  @@map("chat_profile_evidence")
}

/// One daily (or manual) batch run of queue-based matching.
model MatchBatch {
  id           String   @id @default(cuid())
  batchDate    DateTime
  status       String
  totalUsers   Int      @default(0)
  successCount Int      @default(0)
  failedCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  queueItems BatchMatchQueue[]
  results    MatchResult[]

  @@map("match_batches")
}

/// User waiting to be processed in a batch (P0: one waiting row per user at a time).
model BatchMatchQueue {
  id        String   @id @default(cuid())
  userId    String
  batchId   String?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch MatchBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@map("batch_match_queue")
}

/// Final one-to-one match outcome for a viewer in a given batch (multiple historical rows allowed).
model MatchResult {
  id              String   @id @default(cuid())
  userId          String
  candidateUserId String
  batchId         String
  finalScore      Float?
  reasonSummary   String?
  matchInsights   Json?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User       @relation("MatchResultViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate User       @relation("MatchResultCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  batch                MatchBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  conversations        Conversation[]
  rrmTop2DisplayMeta     MatchResultRrmTop2DisplayMeta?
  rrmTop2DisplayHookJobs MatchResultRrmTop2DisplayHookJob[]

  @@map("match_results")
}

/// Directed friendship (A→B). Match success writes both directions (`match_auto`).
model UserFriendship {
  id            String   @id @default(cuid())
  userId        String
  friendUserId  String
  source        String
  matchResultId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipPeer", fields: [friendUserId], references: [id], onDelete: Cascade)

  @@unique([userId, friendUserId])
  @@index([userId, createdAt])
  @@map("user_friendships")
}

/// One-to-one chat between two matched users.
model Conversation {
  id               String   @id @default(cuid())
  viewerUserId    String
  candidateUserId String
  matchResultId   String?
  status          String   // active / closed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  viewer     User @relation("ConversationViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  candidate  User @relation("ConversationCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  matchResult MatchResult? @relation(fields: [matchResultId], references: [id], onDelete: SetNull)

  messages        Message[]
  chatSummaries   ConversationSummary[]
  behaviorSignals BehaviorSignal[]

  @@map("conversations")
}

/// Persisted messages in a conversation (no websocket in P0).
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- P2: minimal persistence (rule/template/placeholder/hybrid; no silent UserProfile writes) ---

/// Persisted chat summary snapshots per conversation (latest row by createdAt until API defines otherwise).
model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String
  summary        String   @db.Text
  chatStageHint  String?
  sourceType     String
  sourceVersion  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_summaries")
}

/// Structured feedback (subjectKind/subjectId align with shared P2FeedbackSubjectKind + opaque ids).
model UserFeedback {
  id            String   @id @default(cuid())
  userId        String
  subjectKind   String
  subjectId     String
  sourceType    String
  sourceVersion String
  rating        Int?
  tags          String[] @default([])
  comment       String?  @db.Text
  /// P6.12: optional structured chat feedback (v0); null = legacy P4 or rating-only rows.
  structuredPayload Json?
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, subjectKind, subjectId, recordedAt])
  @@map("user_feedbacks")
}

/// Proposed patch to questionnaire-derived profile — only materialized onto UserProfile after explicit accept.
model ProfileUpdateSuggestion {
  id            String    @id @default(cuid())
  userId        String
  status        String @default("pending") // pending | accepted | dismissed
  sourceType    String
  sourceVersion String
  /// Optional: chat conversation that produced this row (e.g. P6.8 duplicate guard).
  sourceConversationId String?
  /// P6.8: latest `messages.id` in the conversation at generation time (cursor for R1 / traceability).
  generatedUpToMessageId String?
  /// P6.8 chat: human-readable review payload derived from the same hint items as `proposedPatch` (optional on legacy rows).
  reviewSummary Json?
  proposedPatch Json
  // P5: 运营与优先级字段
  priority      String @default("medium") // low | medium | high
  category      String @default("profile_refinement") // profile_refinement | behavioral_insight | communication_style
  assignedToOperatorId String? // P5：运营人员分配（可选）
  operatorNotes String? @db.Text // P5：运营备注
  versionNumber Int @default(1) // P5：版本号，用于跟踪历史
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  history SuggestionHistory[] // P5：历史记录关系

  @@index([userId, status])
  @@index([userId, sourceConversationId, sourceVersion, status])
  @@index([status, priority])
  @@index([assignedToOperatorId])
  @@index([versionNumber])
  @@map("profile_update_suggestions")
}

// P5：建议版本历史记录
model SuggestionHistory {
  id            String    @id @default(cuid())
  suggestionId  String
  version       Int       // 版本号
  previousVersion Int?    // 前一个版本号
  changes       Json      // 变更内容：{ fieldName: { old, new } }
  changedFields String[]  // 变更字段列表
  changedByUserId String  // 谁做的变更
  changeReason  String?   // 变更原因/备注
  changeType    String @default("UPDATE") // UPDATE | ACCEPT | DISMISS | ASSIGN
  createdAt     DateTime  @default(now())

  suggestion ProfileUpdateSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  changedByUser User @relation("SuggestionHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([suggestionId])
  @@index([changedByUserId])
  @@index([createdAt])
  @@index([suggestionId, createdAt(sort: Desc)])
  @@map("suggestion_history")
}

// P5 Phase 2：审计日志表，记录所有关键操作
model AuditLog {
  id            String    @id @default(cuid())
  userId        String
  action        String    // CREATE | READ | UPDATE | DELETE | EXPORT | BULK_OPERATE | ROLE_ASSIGN
  entityType    String    // SUGGESTION | USER | ROLE | PERMISSION | SYSTEM
  entityId      String?   // 被操作的对象ID
  oldValues     Json?     // 变更前的值 (JSONB)
  newValues     Json?     // 变更后的值 (JSONB)
  ipAddress     String?   // IP地址
  userAgent     String?   // User-Agent字符串
  changeReason  String?   // 用户填写的原因
  status        String @default("SUCCESS") // SUCCESS | FAILED
  errorMessage  String?   // 错误信息
  duration      Int?      // 操作耗时 (ms)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@index([status])
  @@map("audit_logs")
}

// P5 Phase 2.2: 角色分配表 - 将用户与角色绑定（支持角色过期时间）
model UserRole {
  id          String    @id @default(cuid())
  userId      String
  roleCode    String    // ADMIN | OPERATOR | DATA_ANALYST | REGULAR_USER
  grantedAt   DateTime  @default(now())
  grantedBy   String?   // 谁授予的这个角色（可选）
  expiresAt   DateTime? // 角色过期时间（可选，为null则永不过期）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User  @relation("UserRolesAssigned", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserRolesGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleCode]) // 一个用户一个角色只能有一份
  @@index([userId])
  @@index([roleCode])
  @@index([expiresAt])
  @@map("user_roles")
}

// P5 Phase 2.2: 角色权限映射表 - 定义每个角色具有哪些权限
model RolePermission {
  id              String    @id @default(cuid())
  roleCode        String    // ADMIN | OPERATOR | DATA_ANALYST | REGULAR_USER
  permissionCode  String    // view_all_suggestions | manage_all_suggestions | etc
  resource        String?   // 资源类型（可选，用于细粒度权限控制）
  conditions      Json?     // 条件权限（如时间限制、IP限制等，JSONB格式）
  createdAt       DateTime  @default(now())

  @@unique([roleCode, permissionCode]) // 一个角色一个权限只能有一份
  @@index([roleCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

// P5 Phase 2.3: 通知表 - 持久化通知消息，支持实时推送与离线查看
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // role_change | permission_update | suggestion_update | system_message | audit_alert | export_completed
  title     String
  message   String   @db.Text
  actionUrl String?  // 前端深链接，如 /permissions, /audit-logs
  read      Boolean  @default(false)
  metadata  Json?    // 额外结构化数据 (entityId, roleCode, etc)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-oriented behavior / analytics-oriented events (no separate analytics dimension table in P2 v1).
model BehaviorSignal {
  id             String   @id @default(cuid())
  userId         String
  eventType      String
  sourceType     String
  sourceVersion  String
  occurredAt     DateTime @default(now())
  conversationId String?
  sessionId      String?
  properties     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([conversationId])
  @@map("behavior_signals")
}

/// P7.6-r8b: allowlist-only Route C apply sidecar (audit / rollback; not MatchResult / display / worker).
model P76AllowlistApplyMeta {
  id                              String    @id @default(cuid())
  viewerUserId                    String
  selectedCandidateId             String
  sourcePipeline                  String    @default("p7.6_route_c")
  schemaVersion                   String
  sourceVersion                   String
  routeCArtifactPath              String?
  stage1SelectedCandidateIds      Json
  stage2Top2CandidateIds          Json
  selectedBy20DOnlyCandidateId    String?
  selectedByRrmCandidateId        String?
  finalShadowSelectedCandidateId  String
  allowlistMatched                Boolean   @default(false)
  pmSignoffStatus                 String    @default("pending")
  opsSignoffStatus                String    @default("pending")
  applied                         Boolean   @default(false)
  appliedToPool                   Boolean   @default(false)
  appliedToMatchResult            Boolean   @default(false)
  appliedToFinalScore             Boolean   @default(false)
  appliedToDisplay                Boolean   @default(false)
  appliedToWorkerRanking          Boolean   @default(false)
  dryRun                          Boolean   @default(true)
  appliedAt                       DateTime?
  appliedBy                       String?
  rolledBack                      Boolean   @default(false)
  rolledBackAt                    DateTime?
  rolledBackBy                    String?
  rollbackReason                  String?
  rollbackToken                   String?
  auditNotes                      Json?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  viewer User @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([viewerUserId, sourceVersion])
  @@index([viewerUserId])
  @@index([selectedCandidateId])
  @@index([applied])
  @@index([rolledBack])
  @@index([createdAt])
  @@index([sourceVersion])
  @@map("p76_allowlist_apply_meta")
}

/// P7.10-r6e1: canonical writer rehearsal compare sidecar (dev/staging only; not GET/worker).
model P76CanonicalWriterRehearsalMeta {
  id String @id @default(cuid())

  viewerUserId  String
  matchResultId String

  baselineCandidateUserId String?
  proposedCandidateUserId String?

  baselineFinalScore Float?
