/// Local/staging testing observability — event log only; never mutates business tables.
model TestingObservabilityEvent {
  id            String   @id @default(cuid())
  userId        String?
  matchResultId String?
  eventType     String
  status        String
  source        String?
  sourceVersion String?
  fallbackUsed  Boolean?
  errorCode     String?
  message       String?  @db.Text
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([matchResultId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("testing_observability_events")
}

/// Local/staging match feedback from testing monitor; does not update MatchResult.
