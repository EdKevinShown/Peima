// Peima — database schema
// Migrations: pnpm --filter @peima/database db:migrate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User profile (no auth in this iteration — phone is the natural key).
model User {
  id               String   @id @default(cuid())
  phone            String   @unique
  nickname         String
  gender           String   @default("")
  age              Int?
  city             String   @default("")
  height           Int?
  education        String   @default("")
  occupation       String   @default("")
  relationshipGoal String   @default("")
  bio              String   @default("") @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  preference                   UserPreference?
  images                       UserImage[]
  previewPools                 PreviewPool[]
  previewPoolItemsAsViewer     PreviewPoolItem[] @relation("PreviewPoolItemViewer")
  previewPoolItemsAsCandidate  PreviewPoolItem[] @relation("PreviewPoolItemCandidate")
  questionnaireAnswers         QuestionnaireAnswer[]
  relationProfile              UserProfile?
  matchQueueEntries            BatchMatchQueue[]
  matchResultsAsViewer         MatchResult[]       @relation("MatchResultViewer")
  matchResultsAsCandidate      MatchResult[]       @relation("MatchResultCandidate")
  conversationEntriesAsViewer Conversation[] @relation("ConversationViewer")
  conversationEntriesAsCandidate Conversation[] @relation("ConversationCandidate")
  messagesAsSender Message[] @relation("MessageSender")
  structuredFeedbacks      UserFeedback[]
  profileUpdateSuggestions ProfileUpdateSuggestion[]
  behaviorSignals          BehaviorSignal[]
  suggestionHistoryChanges SuggestionHistory[] @relation("SuggestionHistoryChangedBy") // P5：历史变更记录
  auditLogs                AuditLog[] // P5 Phase 2：审计日志记录
  rolesAssigned            UserRole[] @relation("UserRolesAssigned") // P5 Phase 2.2：分配给该用户的角色
  rolesGrantedByMe         UserRole[] @relation("UserRolesGrantedBy") // P5 Phase 2.2：由该用户授予的角色
  notifications            Notification[] // P5 Phase 2.3：通知记录

  @@map("users")
}

/// Partner / filter preferences for matching (one row per user; extend with new scalar/array columns or JSON later).
model UserPreference {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  minAge                      Int?
  maxAge                      Int?
  preferredCities             String[] @default([])
  minHeight                   Int?
  maxHeight                   Int?
  educationPreferences        String[] @default([])
  occupationPreferences       String[] @default([])
  relationshipGoalPreferences String[] @default([])
  styleTags                   String[] @default([])
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// User photo metadata + analysis snapshot (URL assumed already hosted; no binary stored here).
model UserImage {
  id                  String   @id @default(cuid())
  userId              String
  imageUrl            String
  faceEmbedding       Json?
  attractivenessScore Float?
  styleTags           String[] @default([])
  ageEstimate         Int?
  genderEstimate      String?
  confidence          Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_images")
}

/// A generated 6-slot preview pool for one viewer user (P0: single active pool per user after latest generate).
model PreviewPool {
  id        String   @id @default(cuid())
  userId    String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PreviewPoolItem[]

  @@map("preview_pools")
}

/// One candidate slot inside a preview pool (layered display: full / blurred / locked).
model PreviewPoolItem {
  id              String   @id @default(cuid())
  previewPoolId   String
  userId          String
  candidateUserId String
  candidateType   String
  displayMode     String
  rankInPool      Int
  baseScore       Float?
  itemMeta        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  previewPool PreviewPool @relation(fields: [previewPoolId], references: [id], onDelete: Cascade)
  viewer      User        @relation("PreviewPoolItemViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate   User        @relation("PreviewPoolItemCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@map("preview_pool_items")
}

/// Single submission of lightweight relationship questionnaire answers (latest submit replaces rows in P0).
model QuestionnaireAnswer {
  id          String   @id @default(cuid())
  userId      String
  questionKey String
  answerValue String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("questionnaire_answers")
}

/// Derived relation-style profile from questionnaire (one row per user).
model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  socialEnergy        Float?
  emotionalExpression Float?
  relationshipPace    Float?
  initiativeLevel     Float?
  decisionOrientation Float?
  conflictResponse    Float?
  /// G1-R 轴 1–20（与 `G1R_PROFILE_KEYS` / `scoreQuestionnaireG1r` 一致）；`emotionalExpression` 与 legacy 列复用。
  attachmentStyle       Float?
  communicationStyle    Float?
  conflictHandling        Float?
  loveLanguage            Float?
  securityNeed            Float?
  controlNeed             Float?
  independence            Float?
  loyaltyView             Float?
  jealousyTendency        Float?
  moneyAttitude           Float?
  careerPriority          Float?
  lifePace                Float?
  socialNeed              Float?
  emotionalStability      Float?
  sexualValues            Float?
  familyView              Float?
  marriageExpectation     Float?
  childrenIntent          Float?
  riskPreference          Float?
  confidence          Float?
  /// Accepted P6.8 chat-based dimension-branch hints (supplement to questionnaire layer1; not answer SOT).
  dimensionBranchChatHints Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

/// One daily (or manual) batch run of queue-based matching.
model MatchBatch {
  id           String   @id @default(cuid())
  batchDate    DateTime
  status       String
  totalUsers   Int      @default(0)
  successCount Int      @default(0)
  failedCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  queueItems BatchMatchQueue[]
  results    MatchResult[]

  @@map("match_batches")
}

/// User waiting to be processed in a batch (P0: one waiting row per user at a time).
model BatchMatchQueue {
  id        String   @id @default(cuid())
  userId    String
  batchId   String?
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch MatchBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@map("batch_match_queue")
}

/// Final one-to-one match outcome for a viewer in a given batch (multiple historical rows allowed).
model MatchResult {
  id              String   @id @default(cuid())
  userId          String
  candidateUserId String
  batchId         String
  finalScore      Float?
  reasonSummary   String?
  matchInsights   Json?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User       @relation("MatchResultViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate User       @relation("MatchResultCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  batch     MatchBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@map("match_results")
}

/// One-to-one chat between two matched users.
model Conversation {
  id               String   @id @default(cuid())
  viewerUserId    String
  candidateUserId String
  matchResultId   String?
  status          String   // active / closed
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  viewer     User @relation("ConversationViewer", fields: [viewerUserId], references: [id], onDelete: Cascade)
  candidate  User @relation("ConversationCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)
  matchResult MatchResult? @relation(fields: [matchResultId], references: [id], onDelete: SetNull)

  messages        Message[]
  chatSummaries   ConversationSummary[]
  behaviorSignals BehaviorSignal[]

  @@map("conversations")
}

/// Persisted messages in a conversation (no websocket in P0).
model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderUserId   String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User        @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// --- P2: minimal persistence (rule/template/placeholder/hybrid; no silent UserProfile writes) ---

/// Persisted chat summary snapshots per conversation (latest row by createdAt until API defines otherwise).
model ConversationSummary {
  id             String   @id @default(cuid())
  conversationId String
  summary        String   @db.Text
  chatStageHint  String?
  sourceType     String
  sourceVersion  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("conversation_summaries")
}

/// Structured feedback (subjectKind/subjectId align with shared P2FeedbackSubjectKind + opaque ids).
model UserFeedback {
  id            String   @id @default(cuid())
  userId        String
  subjectKind   String
  subjectId     String
  sourceType    String
  sourceVersion String
  rating        Int?
  tags          String[] @default([])
  comment       String?  @db.Text
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@index([userId, subjectKind, subjectId, recordedAt])
  @@map("user_feedbacks")
}

/// Proposed patch to questionnaire-derived profile — only materialized onto UserProfile after explicit accept.
model ProfileUpdateSuggestion {
  id            String    @id @default(cuid())
  userId        String
  status        String @default("pending") // pending | accepted | dismissed
  sourceType    String
  sourceVersion String
  /// Optional: chat conversation that produced this row (e.g. P6.8 duplicate guard).
  sourceConversationId String?
  proposedPatch Json
  // P5: 运营与优先级字段
  priority      String @default("medium") // low | medium | high
  category      String @default("profile_refinement") // profile_refinement | behavioral_insight | communication_style
  assignedToOperatorId String? // P5：运营人员分配（可选）
  operatorNotes String? @db.Text // P5：运营备注
  versionNumber Int @default(1) // P5：版本号，用于跟踪历史
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resolvedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  history SuggestionHistory[] // P5：历史记录关系

  @@index([userId, status])
  @@index([userId, sourceConversationId, sourceVersion, status])
  @@index([status, priority])
  @@index([assignedToOperatorId])
  @@index([versionNumber])
  @@map("profile_update_suggestions")
}

// P5：建议版本历史记录
model SuggestionHistory {
  id            String    @id @default(cuid())
  suggestionId  String
  version       Int       // 版本号
  previousVersion Int?    // 前一个版本号
  changes       Json      // 变更内容：{ fieldName: { old, new } }
  changedFields String[]  // 变更字段列表
  changedByUserId String  // 谁做的变更
  changeReason  String?   // 变更原因/备注
  changeType    String @default("UPDATE") // UPDATE | ACCEPT | DISMISS | ASSIGN
  createdAt     DateTime  @default(now())

  suggestion ProfileUpdateSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  changedByUser User @relation("SuggestionHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([suggestionId])
  @@index([changedByUserId])
  @@index([createdAt])
  @@index([suggestionId, createdAt(sort: Desc)])
  @@map("suggestion_history")
}

// P5 Phase 2：审计日志表，记录所有关键操作
model AuditLog {
  id            String    @id @default(cuid())
  userId        String
  action        String    // CREATE | READ | UPDATE | DELETE | EXPORT | BULK_OPERATE | ROLE_ASSIGN
  entityType    String    // SUGGESTION | USER | ROLE | PERMISSION | SYSTEM
  entityId      String?   // 被操作的对象ID
  oldValues     Json?     // 变更前的值 (JSONB)
  newValues     Json?     // 变更后的值 (JSONB)
  ipAddress     String?   // IP地址
  userAgent     String?   // User-Agent字符串
  changeReason  String?   // 用户填写的原因
  status        String @default("SUCCESS") // SUCCESS | FAILED
  errorMessage  String?   // 错误信息
  duration      Int?      // 操作耗时 (ms)
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@index([status])
  @@map("audit_logs")
}

// P5 Phase 2.2: 角色分配表 - 将用户与角色绑定（支持角色过期时间）
model UserRole {
  id          String    @id @default(cuid())
  userId      String
  roleCode    String    // ADMIN | OPERATOR | DATA_ANALYST | REGULAR_USER
  grantedAt   DateTime  @default(now())
  grantedBy   String?   // 谁授予的这个角色（可选）
  expiresAt   DateTime? // 角色过期时间（可选，为null则永不过期）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User  @relation("UserRolesAssigned", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User? @relation("UserRolesGrantedBy", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([userId, roleCode]) // 一个用户一个角色只能有一份
  @@index([userId])
  @@index([roleCode])
  @@index([expiresAt])
  @@map("user_roles")
}

// P5 Phase 2.2: 角色权限映射表 - 定义每个角色具有哪些权限
model RolePermission {
  id              String    @id @default(cuid())
  roleCode        String    // ADMIN | OPERATOR | DATA_ANALYST | REGULAR_USER
  permissionCode  String    // view_all_suggestions | manage_all_suggestions | etc
  resource        String?   // 资源类型（可选，用于细粒度权限控制）
  conditions      Json?     // 条件权限（如时间限制、IP限制等，JSONB格式）
  createdAt       DateTime  @default(now())

  @@unique([roleCode, permissionCode]) // 一个角色一个权限只能有一份
  @@index([roleCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

// P5 Phase 2.3: 通知表 - 持久化通知消息，支持实时推送与离线查看
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // role_change | permission_update | suggestion_update | system_message | audit_alert | export_completed
  title     String
  message   String   @db.Text
  actionUrl String?  // 前端深链接，如 /permissions, /audit-logs
  read      Boolean  @default(false)
  metadata  Json?    // 额外结构化数据 (entityId, roleCode, etc)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-oriented behavior / analytics-oriented events (no separate analytics dimension table in P2 v1).
model BehaviorSignal {
  id             String   @id @default(cuid())
  userId         String
  eventType      String
  sourceType     String
  sourceVersion  String
  occurredAt     DateTime @default(now())
  conversationId String?
  sessionId      String?
  properties     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([conversationId])
  @@map("behavior_signals")
}
