{
  "name": "peima",
  "version": "0.0.1",
  "private": true,
  "description": "Peima — AI relationship matching system (monorepo)",
  "scripts": {
    "prepare": "pnpm --filter @peima/database run db:generate",
    "dev:web": "pnpm --filter @peima/web dev",
    "dev:admin": "pnpm --filter @peima/admin dev",
    "dev:api": "dotenv -e .env --override -- pnpm --filter @peima/api dev",
    "dev:worker": "dotenv -e .env --override -- pnpm --filter @peima/worker run dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter @peima/web build",
    "build:admin": "pnpm --filter @peima/admin build",
    "build:api": "pnpm --filter @peima/api build",
    "lint": "pnpm -r run lint --if-present",
    "clean": "pnpm -r exec rimraf dist node_modules/.cache",
    "db:migrate:deploy": "dotenv -e .env --override -- pnpm --filter @peima/database run db:migrate:deploy",
    "test:e2e": "pnpm --filter @peima/e2e test",
    "test:e2e:onboarding": "pnpm --filter @peima/e2e test:onboarding",
    "test:e2e:final-match": "pnpm --filter @peima/e2e test:final-match",
    "test:e2e:install": "pnpm --filter @peima/e2e install:browsers"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "tsx": "^4.21.0"
  }
}
