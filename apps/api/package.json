{
  "name": "@peima/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @peima/database build && pnpm --filter @peima/shared build && pnpm --filter @peima/ai-simulation-v1-runner run build && pnpm --filter @peima/ai-pairwise-decision-runner run build:worker",
    "prestart:dev": "pnpm --filter @peima/ai-simulation-v1-runner run build && pnpm --filter @peima/ai-pairwise-decision-runner run build:worker",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --config ./jest.config.cjs",
    "test:e2e": "jest --config ./jest-e2e.config.cjs --runInBand",
    "test:e2e:orch-anchor": "jest --config ./jest-e2e.config.cjs --runInBand --testPathPattern=run-orchestration-mvp",
    "m5-m4b:shadow-audit-runner": "node dist/dev-cli/m5-m4b-shadow-audit-runner.js",
    "m55-m0:rrm-top2-display-fixture": "node dist/dev-cli/m55-m0-rrm-top2-display-fixture.js",
    "m55-m2:rrm-top2-meta-writer": "node dist/dev-cli/m55-m2-rrm-top2-meta-writer-cli.js",
    "m55-m4:rrm-top2-production-hook": "node dist/dev-cli/m55-m4-rrm-top2-production-hook-cli.js",
    "m56-b3:rrm-top2-hook-job": "node dist/dev-cli/m56-b3-rrm-top2-hook-job-cli.js",
    "m56-b4b:rrm-top2-hook-job-consumer": "node dist/dev-cli/m56-b4b-rrm-top2-hook-job-consumer-cli.js",
    "m56-b5:rrm-top2-hook-job-apply": "node dist/dev-cli/m56-b5-rrm-top2-hook-job-apply-cli.js",
    "m56-b8:rrm-top2-hook-job-dry-run-poller": "node dist/dev-cli/m56-b8-rrm-top2-hook-job-dry-run-poller-cli.js",
    "p74:r1b-face-runtime-check": "node scripts/p74-r1b-face-runtime-check.mjs",
    "p75:r4-shadow-audit": "node dist/dev-cli/p75-r4-visual-ranking-shadow-audit-runner.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/websockets": "^10.4.22",
    "@peima/ai-pairwise-decision-runner": "workspace:*",
    "@peima/ai-simulation-v1-runner": "workspace:*",
    "@peima/database": "workspace:*",
    "@peima/shared": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@angular-devkit/schematics-cli": "^17.3.17",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
